# Personal Finance Advisor Bot - Environment Configuration
# Copy this file to .env and configure your secret values.

# Flask Application Secret Key for secure sessions
SECRET_KEY=change_this_to_a_secure_random_string_in_production

# Google Gemini API Key
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
